    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.13"
  },
  "overrides": {
    "@vercel/nft": {
      "glob": "14.0.4"
    },
    "readdir-glob": {
      "minimatch": "11.0.5"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
